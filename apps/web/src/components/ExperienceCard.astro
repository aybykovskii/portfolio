---
import type { CollectionEntry } from 'astro:content'
import { Calendar, ChevronRight, MapPin } from 'lucide-react'

import type { Translated } from '@/i18n'

import { LinkTitle } from './LinkTitle'
import TechnologiesList from './TechnologiesList.astro'

interface Props {
  experience: Translated<CollectionEntry<'experiences'>['data']>
  technologies: CollectionEntry<'technologies'>[]
}

const {
  experience: { position, company, companyUrl, start, end, location, description, achievements },
  technologies,
} = Astro.props

const { commonTranslations } = Astro.locals

const subInfo = [
  {
    icon: Calendar,
    value: `${start} – ${end}`,
  },
  {
    icon: MapPin,
    value: location,
  },
]
---
<div class="card card-body card-border shadow-sm">
  <h3 class="card-title">{position}</h3>

  <LinkTitle href={companyUrl} title={company} />

  <div class="flex gap-3">
    {subInfo.map(({ icon: Icon, value }) => (
      <span class="flex items-center gap-2 text-base-content/60 text-sm">
        <Icon size={14} />
        {value}
      </span>
    ))}
  </div>

  <p class="text-base leading-relaxed">{description}</p>

  <details class="group collapse">
    <summary class="flex items-center gap-3 cursor-pointer collapse-title pl-0">
      <ChevronRight
        size={18}
        color="var(--color-primary)"
        className="transition-transform duration-200 group-open:rotate-90"
      />
      <span class="text-base-content leading-snug">
        {commonTranslations.experience.achievements}
      </span>
    </summary>

    <ul class="flex flex-col gap-3 border-l-primary border-l ml-[9px] collapse-content">
      {achievements.map((achievement) => (
        <li class="text-base-content text-base before:mr-3 before:text-primary before:content-['-']">
          {achievement}
        </li>
      ))}
    </ul>
  </details>

  <TechnologiesList technologies={technologies} />
</div>
